@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="copyable-value">
    <div class="value-header">
        <span id="@_labelId" class="value-label">@Label</span>
        <button type="button"
                class="@(_copied ? "copy-button copied" : "copy-button")"
                disabled="@(Disabled || string.IsNullOrEmpty(Value))"
                aria-disabled="@(IsDisabled ? "true" : "false")"
                aria-describedby="@_statusId"
                @onclick="CopyAsync">
            <span aria-hidden="true">@(_copied ? "✓" : "⧉")</span>
            @(_copying ? "Copying…" : _copied ? "Copied" : CopyText)
        </button>
    </div>
    <output class="value" aria-labelledby="@_labelId">@Value</output>
    <span id="@_statusId"
          class="@(_failed ? "status error" : "status")"
          role="status"
          aria-live="polite"
          aria-atomic="true">@_status</span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public string Value { get; set; } = "";

    [Parameter]
    public string CopyText { get; set; } = "Copy";

    [Parameter]
    public string SuccessMessage { get; set; } = "Copied to the clipboard.";

    [Parameter]
    public string FailureMessage { get; set; } = "Could not copy the value.";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> OnCopied { get; set; }

    [Parameter]
    public EventCallback<string> OnCopyFailed { get; set; }

    [Parameter]
    public string ModulePath { get; set; } = "./Components/CopyableValue.razor.js";

    private readonly string _labelId = $"copy-label-{Guid.NewGuid():N}";
    private readonly string _statusId = $"copy-status-{Guid.NewGuid():N}";
    private readonly CancellationTokenSource _lifetime = new();
    private IJSObjectReference? _module;
    private bool _copying;
    private bool _copied;
    private bool _failed;
    private bool _disposed;
    private int _attempt;
    private string _status = "";

    // Keep the busy button focusable; aria-disabled and the handler guard block repeats.
    private bool IsDisabled => Disabled || _copying || string.IsNullOrEmpty(Value);

    private async Task CopyAsync()
    {
        if (IsDisabled || _disposed)
            return;

        var attempt = ++_attempt;
        var value = Value;
        _copying = true;
        _copied = false;
        _failed = false;
        _status = "";

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _module.InvokeVoidAsync("copyText", value);
            if (_disposed)
                return;

            _copied = true;
            _status = SuccessMessage;
        }
        catch (JSException)
        {
            if (_disposed)
                return;

            _failed = true;
            _status = FailureMessage;
        }
        finally
        {
            _copying = false;
        }

        if (_disposed)
            return;

        // Parent callback errors are not clipboard failures.
        if (_failed)
        {
            await OnCopyFailed.InvokeAsync(FailureMessage);
            return;
        }

        StateHasChanged();
        await OnCopied.InvokeAsync(value);

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2), _lifetime.Token);
            if (!_disposed && attempt == _attempt)
            {
                _copied = false;
                _status = "";
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // Disposal cancels pending feedback.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _lifetime.CancelAsync();
        _lifetime.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Also supports use in a disconnected Blazor Server circuit.
            }
        }
    }
}

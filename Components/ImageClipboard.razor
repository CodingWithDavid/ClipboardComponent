@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="image-panel" aria-labelledby="@_headingId" @ref="_root">
    <div class="heading">
        <h2 id="@_headingId">Images, ready to go.</h2>
        <span class="badge">IMAGE CLIPBOARD</span>
    </div>
    <p>Choose an image to copy, or bring one in from your clipboard. Nothing is uploaded.</p>

    <label class="file-label">
        Choose an image
        <input type="file" accept="image/png,image/jpeg,image/webp,image/gif"
               disabled="@(!_ready || _state.Busy)" />
    </label>
    <p class="hint">PNG, JPEG, WebP, or GIF. Up to 10 MB and 16 million pixels. Copied as PNG; animated images use one frame.</p>
    <p class="hint">Copied a file in Windows File Explorer? Focus the preview below and press Ctrl+V.
        The Paste image button reads image contents, not file references. If your browser does not
        provide the file, use Choose an image or open the image and copy its contents.</p>

    <div class="actions">
        <button type="button" data-action="copy" disabled="@(!_ready || _state.Url is null)"
                aria-disabled="@(_state.Busy ? "true" : "false")" aria-describedby="@_statusId">Copy image</button>
        <button type="button" data-action="paste" disabled="@(!_ready)"
                aria-disabled="@(_state.Busy ? "true" : "false")" aria-describedby="@_statusId">Paste image</button>
    </div>

    <div class="paste-target" tabindex="0" role="group" aria-label="Image paste area"
         aria-describedby="@_hintId" aria-busy="@(_state.Busy ? "true" : "false")">
        @if (_state.Url is not null)
        {
            <img src="@_state.Url" alt="@($"Preview of {_state.Name}")" />
            <span class="image-name">@_state.Name</span>
        }
        else
        {
            <span class="empty-mark" aria-hidden="true">+</span>
            <span>Your next image goes here.</span>
        }
        <span id="@_hintId" class="hint">Focus this area and press Ctrl+V (Command+V on Mac) to paste an image.</span>
    </div>
    <span id="@_statusId" class="@(_state.Error ? "status error" : "status")"
          role="status" aria-live="polite" aria-atomic="true">@_state.Status</span>
</section>

@code {
    private readonly string _headingId = $"image-heading-{Guid.NewGuid():N}";
    private readonly string _statusId = $"image-status-{Guid.NewGuid():N}";
    private readonly string _hintId = $"image-hint-{Guid.NewGuid():N}";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<ImageClipboard>? _reference;
    private ImageState _state = new();
    private bool _ready;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/ImageClipboard.razor.js");
            _reference = DotNetObjectReference.Create(this);
            _controller = await _module.InvokeAsync<IJSObjectReference>("create", _root, _reference);
            _ready = true;
        }
        catch (JSException)
        {
            _state = new() { Error = true, Status = "Image tools could not load. Reload the page to try again." };
        }

        StateHasChanged();
    }

    [JSInvokable]
    public Task UpdateImageState(ImageState state)
    {
        if (!_disposed)
        {
            _state = state;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_controller is not null)
        {
            await _controller.InvokeVoidAsync("dispose");
            await _controller.DisposeAsync();
        }
        if (_module is not null)
            await _module.DisposeAsync();
        _reference?.Dispose();
    }

    public sealed class ImageState
    {
        public string? Url { get; set; }
        public string Name { get; set; } = "";
        public string Status { get; set; } = "Choose or paste an image to get started.";
        public bool Error { get; set; }
        public bool Busy { get; set; }
    }
}
